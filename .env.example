# Build (GitHub Pages: set to /your-repo-name/)
VITE_BASE_PATH=/

# Optional: if API runs on another origin (e.g. Vercel app while game is on Pages)
# VITE_API_BASE=https://your-tokemon-api.vercel.app

# Local dev + Vercel - enables real AI (omit for offline mock replies)
OPENROUTER_API_KEY=

# Optional model override
# VITE_CHAT_MODEL=openrouter/auto
